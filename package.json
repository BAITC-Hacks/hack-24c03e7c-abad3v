{
  "name": "ai-sana-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace server\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "npm run dev --workspace server",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server && npm run test:client",
    "test:client": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "openai": "^7.23.0",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.1.0",
    "typescript": "latest",
    "vite": "latest"
  }
}
